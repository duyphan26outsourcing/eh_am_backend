# =============================================================================
# BIẾN MÔI TRƯỜNG — MẪU CHO DEVELOPMENT (EVERY HALF · QUẢN LÝ TÀI SẢN)
# =============================================================================
#
# Copy thành `.env` rồi điền giá trị. `.gitignore` đã chặn mọi biến thể `.env*`,
# chỉ chừa lại đúng file mẫu này và `.env.production.example`.
#
# ⚠️ MỖI MÔI TRƯỜNG MỘT FILE `.env` TRÊN MÁY CỦA NÓ.
# Đừng tạo `.env.development` / `.env.production` trong repo:
# `ConfigModule.forRoot({ isGlobal: true })` ở `src/app.module.ts` không khai
# `envFilePath`, nên NestJS CHỈ đọc `.env`. File đặt tên khác sẽ bị bỏ qua âm thầm.
#
# Hai file `.env.development.local` / `.env.production.local` là BẢN LƯU để copy
# sang `.env` khi đổi môi trường — NestJS không đọc chúng.
# =============================================================================


# -----------------------------------------------------------------------------
# BẮT BUỘC
# -----------------------------------------------------------------------------
# Supabase Dashboard → project DEVELOPMENT của Every Half → Settings → API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# service_role key — bỏ qua toàn bộ RLS. Đừng đưa xuống frontend, đừng log ra.
#
# ⚠️ Backend Every Half dùng key này cho mọi lệnh đọc/ghi, và quyền được quyết định
# ở tầng guard của Nest, KHÔNG dựa vào RLS. Nghĩa là mỗi truy vấn đọc dữ liệu tài sản
# phải tự giới hạn theo PHẠM VI LOCATION của người gọi (xem
# `src/auth/access-scope.service.ts`) — thiếu một điều kiện là nhân viên cửa hàng A
# đọc được sổ tài sản, giá trị và lịch sử của cửa hàng B mà không có gì báo lỗi.
SUPABASE_SECRET_KEY=

# ĐÚNG 64 ký tự hex. Sai độ dài là backend ném lỗi ngay lúc khởi động.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Khoá của dev phải KHÁC khoá của production.
ENCRYPTION_SECRET_KEY=


# -----------------------------------------------------------------------------
# KHÔNG CẦN KHAI Ở DEVELOPMENT — GIÁ TRỊ DỰ PHÒNG ĐÃ ĐÚNG
# -----------------------------------------------------------------------------
# Bỏ trống mấy biến dưới đây là ĐÚNG với máy dev, không phải thiếu sót:
#
#   APP_URL       → rơi về http://localhost:5175 (eh_am_frontend, Vite) — nơi có
#                   trang /reset-password và /auth/confirm.
#   CORS_ORIGINS  → rơi về http://localhost:5175.
#   PORT          → 3006 (3005 đã do Avantily/Darlene dùng trên máy dev).
#   NODE_ENV      → nest CLI tự đặt; `isProd` trong src/utils/utils.ts sẽ là false.
#
# Chỉ khai khi cần chạy frontend ở cổng khác mặc định. Ví dụ:
# APP_URL=http://localhost:5180
# CORS_ORIGINS=http://localhost:5180
# PORT=3016

# ⚠️ Phải khớp Authentication > Email OTP Expiration trên Supabase Dashboard.
# Mặc định Supabase là 3600 giây; chỉ khai khi project đã đổi giá trị đó.
# SUPABASE_EMAIL_OTP_EXPIRY_SECONDS=3600

# ⚠️ SỐ TẦNG PROXY — chỉ khai ở production, và phải KHỚP hạ tầng thật.
# Xem chú thích dài ở `src/bootstrap.ts` trước khi đổi. Dev không có proxy nên bỏ trống.
# TRUST_PROXY_HOPS=2


# -----------------------------------------------------------------------------
# CHƯA DÙNG Ở GIAI ĐOẠN NỀN MÓNG — sẽ bật khi làm module tương ứng
# -----------------------------------------------------------------------------
# Kết nối phần mềm kế toán FAST. Tên biến dưới đây chỉ là giữ chỗ — chốt khi Every Half xác
# nhận sản phẩm FAST đang dùng và phương thức tích hợp (API / tệp nhập-xuất).
# FAST_SYNC_ENABLED=false
# FAST_API_BASE_URL=
# FAST_API_CLIENT_ID=
# FAST_API_CLIENT_SECRET=
